// Ops Chatbot - Ask Endpoint
// Deploy as a Supabase Edge Function. Keeps the Anthropic API key server-side,
// so it's never exposed in the public chat webpage.
//
// Deploy with:
//   supabase functions deploy ask-ops --no-verify-jwt
// Set secrets with:
//   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
//   supabase secrets set VOYAGE_API_KEY=...
//   supabase secrets set MANAGER_CODE_WORD=...
//
// Request body shapes handled:
//   { question, history }                      -> normal chat turn
//   { action: "feedback", rating, question, answer } -> thumbs up/down
//   { action: "manager", code }                 -> manager dashboard stats

import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const SUPABASE_URL = Deno.env.get("SUPABASE_URL")!;
const SUPABASE_SERVICE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
const ANTHROPIC_API_KEY = Deno.env.get("ANTHROPIC_API_KEY")!;
const VOYAGE_API_KEY = Deno.env.get("VOYAGE_API_KEY");
const MANAGER_CODE_WORD = Deno.env.get("MANAGER_CODE_WORD"); // e.g. "gaffer report"
// Default location for the weather chit-chat feature - Shannon, Co. Clare.
const WEATHER_LAT = Deno.env.get("WEATHER_LAT") || "52.71";
const WEATHER_LON = Deno.env.get("WEATHER_LON") || "-8.92";
const WEATHER_PLACE = Deno.env.get("WEATHER_PLACE") || "Shannon, Co. Clare";

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY);

const CORS_HEADERS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

function json(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...CORS_HEADERS, "Content-Type": "application/json" },
  });
}

// Convert this app's { role: "user"|"assistant", content } history into
// Claude message format, capped to the last 8 turns to keep prompts lean.
function historyToMessages(history: unknown): { role: string; content: string }[] {
  if (!Array.isArray(history)) return [];
  return history
    .filter((h: any) => h && typeof h.content === "string" && (h.role === "user" || h.role === "assistant"))
    .slice(-8)
    .map((h: any) => ({ role: h.role, content: h.content }));
}

