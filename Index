<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Gaffer | Ops Assistant</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 680 680'%3E%3Ccircle cx='340' cy='340' r='330' fill='%231F3864'/%3E%3Cg transform='translate(340,352)'%3E%3Ccircle cx='0' cy='-20' r='108' fill='%23F0C29B'/%3E%3Cpath d='M -108 -55 Q -108 -140 0 -140 Q 108 -140 108 -55 Q 108 -95 60 -100 Q 20 -125 0 -100 Q -20 -125 -60 -100 Q -108 -95 -108 -55 Z' fill='%235b3a24'/%3E%3C/g%3E%3C/svg%3E">
<style>
  :root {
    --navy: #1F3864;
    --navy-dark: #16294a;
    --green: #548235;
    --green-light: #e8efe3;
    --orange: #FF883E;
    --bg: #eef1f6;
    --border: #dfe4ec;
    --text: #222;
  }
  * { box-sizing: border-box; }
  html, body {
    height: 100%;
    margin: 0;
  }
  body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle, #ccd6e6 1.5px, transparent 1.5px) 0 0 / 26px 26px,
      var(--bg);
  }

  /* soft decorative blobs, flag-toned, well behind everything */
  body::before, body::after, .blob {
    content: "";
    position: fixed;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.35;
    z-index: 0;
  }
  body::before {
    width: 340px; height: 340px;
    background: var(--green);
    top: -120px; left: -120px;
    opacity: 0.18;
  }
  body::after {
    width: 260px; height: 260px;
    background: var(--orange);
    bottom: -80px; right: -80px;
    opacity: 0.16;
  }
  .blob {
    width: 180px; height: 180px;
    background: var(--navy);
    top: 60%; left: -60px;
    opacity: 0.10;
  }

  .logo-corner {
    position: fixed;
    top: 18px; left: 18px;
    width: 130px;
    z-index: 2;
    pointer-events: none;
    user-select: none;
  }
  @media (max-width: 520px) {
    .logo-corner { width: 90px; top: 10px; left: 10px; }
  }

  #page {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
  }

  /* ---- Friendly intro: big avatar + speech bubble ---- */
  #intro {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin-bottom: 14px;
    width: 100%;
    padding: 0 6px;
  }
  .hero-avatar {
    width: 110px; height: 110px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(31, 56, 100, 0.28);
    border: 4px solid white;
  }
  .hero-avatar svg { width: 100%; height: 100%; display: block; }

  .speech-bubble {
    position: relative;
    background: white;
    border-radius: 16px;
    padding: 12px 16px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--navy-dark);
    box-shadow: 0 6px 16px rgba(31, 56, 100, 0.12);
    margin-bottom: 10px;
  }
  .speech-bubble strong { color: var(--navy); }
  .speech-bubble::after {
    content: "";
    position: absolute;
    left: -8px;
    bottom: 14px;
    width: 0; height: 0;
    border-top: 8px solid transparent;
    border-bottom: 8px solid transparent;
    border-right: 10px solid white;
  }

  #widget {
    width: 100%;
    height: min(620px, 78vh);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(31, 56, 100, 0.22);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.6);
    animation: widgetIn 0.5s ease-out;
  }
  @keyframes widgetIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .accent-strip {
    height: 5px;
    flex-shrink: 0;
    background: linear-gradient(90deg, #169B62 0%, #169B62 33%, #ffffff 33%, #ffffff 66%, #FF883E 66%, #FF883E 100%);
  }

  header {
    background: var(--navy);
    color: white;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    border: 2px solid rgba(255,255,255,0.35);
  }
  .avatar svg { width: 100%; height: 100%; display: block; }
  .header-text h1 {
    margin: 0;
    font-size: 16px;
    font-weight: bold;
    white-space: nowrap;
  }
  .header-text p {
    margin: 2px 0 0;
    font-size: 11.5px;
    color: #cdd6e6;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #6fcf5a;
    display: inline-block;
  }

  #chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: #fbfcfd;
  }
  #chat::-webkit-scrollbar { width: 6px; }
  #chat::-webkit-scrollbar-thumb { background: #ccd3de; border-radius: 3px; }

  .msg {
    display: flex;
    flex-direction: column;
    max-width: 82%;
  }
  .msg.user { align-self: flex-end; align-items: flex-end; }
  .msg.bot { align-self: flex-start; align-items: flex-start; }

  .bubble {
    padding: 10px 14px;
    border-radius: 14px;
    line-height: 1.45;
    font-size: 14px;
    white-space: pre-wrap;
  }
  .msg.user .bubble {
    background: var(--navy);
    color: white;
    border-bottom-right-radius: 4px;
  }
  .msg.bot .bubble {
    background: #f1f3f7;
    color: var(--text);
    border-bottom-left-radius: 4px;
  }
  .bubble a { color: var(--navy); font-weight: bold; text-decoration: underline; }
  .msg.user .bubble a { color: white; }

  .sources {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .sources span, .sources a {
    font-size: 11px;
    background: var(--green-light);
    color: var(--green);
    border-radius: 4px;
    padding: 2px 8px;
    text-decoration: none;
  }
  .sources a:hover { text-decoration: underline; }

  .typing {
    display: flex;
    gap: 4px;
    padding: 10px 14px;
    background: #f1f3f7;
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    width: fit-content;
  }
  .typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #a6adb8;
    animation: bounce 1.2s infinite ease-in-out;
  }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  form {
    flex-shrink: 0;
    display: flex;
    gap: 8px;
    padding: 14px;
    border-top: 1px solid var(--border);
    background: white;
  }
  input[type="text"] {
    flex: 1;
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 14px;
    outline: none;
  }
  input[type="text"]:focus { border-color: var(--navy); }
  button {
    background: var(--green);
    color: white;
    border: none;
    width: 42px; height: 42px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  button:hover:not(:disabled) { background: #466c2c; }
  button:disabled { background: #b7c8ab; cursor: default; }
  button svg { width: 18px; height: 18px; }
  #micBtn {
    background: var(--navy);
  }
  #micBtn:hover { background: var(--navy-dark); }
  #micBtn.listening {
    background: #c0392b;
    animation: pulseMic 1s ease-in-out infinite;
  }
  @keyframes pulseMic {
    0%, 100% { box-shadow: 0 0 0 0 rgba(192,57,43,0.5); }
    50% { box-shadow: 0 0 0 8px rgba(192,57,43,0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing span { animation: none; }
  }
  @media (max-width: 520px) {
    body { padding: 12px; }
    #intro { padding: 0 4px; }
    .hero-avatar { width: 78px; height: 78px; }
    #widget { height: 72vh; }
  }

  .feedback {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .feedback button {
    width: auto;
    height: 28px;
    border-radius: 14px;
    padding: 0 10px;
    font-size: 12px;
    background: white;
    color: var(--navy);
    border: 1px solid var(--border);
  }
  .feedback button:hover:not(:disabled) { background: #f3f5f8; }
  .feedback button.selected { background: var(--green-light); color: var(--green); }
  .clear-chat {
    margin-left: auto;
    width: auto;
    height: 30px;
    border-radius: 15px;
    padding: 0 10px;
    font-size: 11px;
    background: rgba(255,255,255,0.14);
  }


  .message-actions {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }
  .message-actions button {
    width: auto;
    height: 26px;
    border-radius: 13px;
    padding: 0 9px;
    font-size: 11px;
    color: var(--navy);
    background: white;
    border: 1px solid var(--border);
  }
  .manager-btn {
    width: auto;
    height: 30px;
    border-radius: 15px;
    padding: 0 10px;
    font-size: 11px;
    background: rgba(255,255,255,0.14);
  }
  .quick-prompts {
    display: flex;
    gap: 7px;
    padding: 8px 14px 0;
    overflow-x: auto;
    background: white;
  }
  .quick-prompts button {
    width: auto;
    height: 30px;
    border-radius: 15px;
    padding: 0 11px;
    white-space: nowrap;
    font-size: 11px;
    color: var(--navy);
    background: #f3f5f8;
    border: 1px solid var(--border);
  }
  dialog {
    border: none;
    border-radius: 18px;
    padding: 0;
    width: min(680px, calc(100vw - 30px));
    box-shadow: 0 24px 70px rgba(0,0,0,.28);
  }
  dialog::backdrop { background: rgba(10,20,35,.55); }
  .manager-panel { padding: 20px; }
  .manager-panel h2 { color: var(--navy); margin: 0 0 12px; }
  .manager-login { display: flex; gap: 8px; }
  .manager-login input { flex: 1; }
  .manager-login button, .dialog-close {
    width: auto; height: 38px; border-radius: 19px; padding: 0 14px;
  }
  .add-info-tab {
    width: auto; height: 36px; border-radius: 18px; padding: 0 16px;
    background: #f3f5f8; color: var(--navy); border: 1px solid var(--border);
    font-size: 13px; cursor: pointer;
  }
  .add-info-tab.active { background: var(--green); color: white; border-color: var(--green); }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 16px 0;
  }
  .stat-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    background: #f8fafc;
  }
  .stat-card strong { display: block; font-size: 24px; color: var(--navy); }
  .manager-columns {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
  }
  .manager-list {
    background: #f8fafc;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
  }
  .manager-list h3 { margin: 0 0 10px; color: var(--navy); }
  .manager-list ol { padding-left: 20px; margin: 0; }
  .manager-list li { margin-bottom: 8px; font-size: 13px; line-height: 1.35; }
  @media (max-width: 620px) {
    .manager-columns { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: 1fr; }
  }


  /* ---- Gaffer 3.2 visual polish ---- */
  body {
    background:
      radial-gradient(circle at 10% 10%, rgba(84,130,53,.18), transparent 30%),
      radial-gradient(circle at 90% 85%, rgba(255,136,62,.16), transparent 30%),
      linear-gradient(135deg, #eef3f8 0%, #f8fafc 48%, #eef4f1 100%);
  }

  #page {
    max-width: 560px;
  }

  #intro {
    margin-bottom: 18px;
  }

  .speech-bubble {
    border: 1px solid rgba(31,56,100,.08);
    box-shadow: 0 12px 30px rgba(31,56,100,.12);
  }

  #widget {
    height: min(700px, 80vh);
    border: 1px solid rgba(31,56,100,.08);
    box-shadow:
      0 30px 80px rgba(31,56,100,.20),
      0 8px 20px rgba(31,56,100,.10);
  }

  header {
    padding: 16px 18px;
    background:
      linear-gradient(135deg, rgba(255,255,255,.06), rgba(255,255,255,0)),
      var(--navy);
  }

  .header-text h1 {
    font-size: 18px;
    letter-spacing: .2px;
  }

  .header-text p {
    font-size: 12px;
  }

  #chat {
    background:
      linear-gradient(rgba(255,255,255,.82), rgba(255,255,255,.82)),
      radial-gradient(circle, rgba(31,56,100,.045) 1px, transparent 1px) 0 0 / 18px 18px;
    padding: 22px;
  }

  .bubble {
    border: 1px solid transparent;
    box-shadow: 0 5px 16px rgba(31,56,100,.08);
  }

  .msg.user .bubble {
    background: linear-gradient(135deg, var(--navy), #2c4e84);
  }

  .msg.bot .bubble {
    background: rgba(255,255,255,.94);
    border-color: rgba(31,56,100,.08);
  }

  .quick-prompts {
    padding: 10px 14px 8px;
    gap: 8px;
    border-top: 1px solid rgba(31,56,100,.06);
  }

  .quick-prompts button {
    background: white;
    border-color: rgba(31,56,100,.12);
    box-shadow: 0 3px 10px rgba(31,56,100,.06);
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
  }

  .quick-prompts button:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(31,56,100,.10);
    background: #f8fafc;
  }

  form {
    padding: 16px;
    box-shadow: 0 -8px 24px rgba(31,56,100,.04);
  }

  input[type="text"] {
    background: #f8fafc;
    border: 1px solid rgba(31,56,100,.12);
    box-shadow: inset 0 1px 2px rgba(31,56,100,.03);
  }

  input[type="text"]:focus {
    background: white;
    box-shadow: 0 0 0 3px rgba(84,130,53,.12);
  }

  #askBtn {
    box-shadow: 0 6px 14px rgba(84,130,53,.28);
  }

  #micBtn {
    box-shadow: 0 6px 14px rgba(31,56,100,.24);
  }

  .manager-btn, .clear-chat {
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.16);
    transition: background .15s ease, transform .15s ease;
  }

  .manager-btn:hover, .clear-chat:hover {
    background: rgba(255,255,255,.22);
    transform: translateY(-1px);
  }

  .message-actions button, .feedback button {
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .message-actions button:hover, .feedback button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(31,56,100,.08);
  }

  .typing {
    background: white;
    border: 1px solid rgba(31,56,100,.08);
    box-shadow: 0 5px 16px rgba(31,56,100,.08);
  }

  @media (max-width: 520px) {
    #page { max-width: 100%; }
    #widget { height: 76vh; border-radius: 18px; }
    #chat { padding: 16px; }
    .quick-prompts { padding-left: 12px; padding-right: 12px; }
  }

</style>
</head>
<body>
<div class="blob"></div>
<img class="logo-corner" src="data:image/png;base64," alt="">

<div id="page">

  <div id="intro">
    <div class="hero-avatar">
      <svg viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg">
        <defs><clipPath id="circleClip"><circle cx="340" cy="340" r="330"/></clipPath></defs>
        <circle cx="340" cy="340" r="330" fill="#1F3864"/>
        <g clip-path="url(#circleClip)" opacity="0.16">
          <g transform="translate(340,300) scale(3.6)" fill="#548235">
            <ellipse cx="0" cy="0" rx="46" ry="5"/>
            <ellipse cx="0" cy="-9" rx="30" ry="4"/>
            <rect x="-3" y="-30" width="6" height="30"/>
            <ellipse cx="0" cy="-30" rx="16" ry="3.5"/>
            <circle cx="0" cy="2" r="5"/>
            <path d="M42 0 L54 -6 L54 6 Z"/>
            <path d="M-42 0 L-54 -6 L-54 6 Z"/>
          </g>
        </g>
        <g transform="translate(340,352)">
          <path d="M -150 210 Q -150 90 0 90 Q 150 90 150 210 Z" fill="#3c5a8a"/>
          <path d="M -150 210 Q -150 90 0 90 L 0 210 Z" fill="#345080"/>
          <circle cx="0" cy="-20" r="108" fill="#F0C29B"/>
          <path d="M -108 -55 Q -108 -140 0 -140 Q 108 -140 108 -55 Q 108 -95 60 -100 Q 20 -125 0 -100 Q -20 -125 -60 -100 Q -108 -95 -108 -55 Z" fill="#5b3a24"/>
          <ellipse cx="-42" cy="-22" rx="10" ry="12" fill="#2b2b2b"/>
          <ellipse cx="42" cy="-22" rx="10" ry="12" fill="#2b2b2b"/>
          <circle cx="-39" cy="-26" r="3" fill="white"/>
          <circle cx="45" cy="-26" r="3" fill="white"/>
          <path d="M -55 -55 Q -42 -66 -28 -56" fill="none" stroke="#4a2e1c" stroke-width="5" stroke-linecap="round"/>
          <path d="M 28 -56 Q 42 -66 55 -55" fill="none" stroke="#4a2e1c" stroke-width="5" stroke-linecap="round"/>
          <path d="M -34 22 Q 0 46 34 22" fill="none" stroke="#8a4a30" stroke-width="6" stroke-linecap="round"/>
          <ellipse cx="0" cy="4" rx="9" ry="12" fill="#e8b489"/>
          <path d="M -110 92 Q -110 60 0 55 Q 110 60 110 92 L 108 210 L -108 210 Z" fill="#548235"/>
          <path d="M -30 60 L 30 60 L 22 92 L -22 92 Z" fill="white"/>
          <rect x="-10" y="58" width="20" height="150" fill="#a6a6a6"/>
          <g transform="translate(150,55) rotate(-8)">
            <rect x="-3" y="-10" width="6" height="150" fill="#7a5230"/>
            <path d="M 3 -10 L 3 55 L 88 22.5 Z" fill="#169B62"/>
          </g>
          <g transform="translate(150,-10)">
            <path d="M 0 0 L 0 65 L 85 32.5 Z" fill="#169B62"/>
            <path d="M 28.3 0 L 28.3 65 L 85 32.5 Z" fill="#ffffff"/>
            <path d="M 56.6 0 L 56.6 65 L 85 32.5 Z" fill="#FF883E"/>
            <rect x="-3" y="0" width="6" height="160" fill="#7a5230"/>
          </g>
        </g>
      </svg>
    </div>
    <div class="speech-bubble">
      Howya! I'm <strong>The Gaffer</strong> &mdash; ask me about Ops SOPs, policies, shared docs, or just say hello. I'll even give you the weather if you're stuck for chat.
    </div>
  </div>

  <div id="widget">
    <div class="accent-strip"></div>
    <header>
      <div class="avatar">
        <svg viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg">
          <use href="#" />
        </svg>
      </div>
      <div class="header-text">
        <h1>The Gaffer</h1>
        <p><span class="status-dot"></span> Ops Assistant &middot; Online</p>
      </div>
      <button id="addInfoBtn" class="manager-btn" type="button">+ Add info</button>
      <button id="clearChat" class="clear-chat" type="button">Clear chat</button>
    </header>

    <div id="chat"></div>

    <div class="quick-prompts" aria-label="Suggested questions">
    <button type="button" data-question="What can you do?">What can you do?</button>
    <button type="button" data-question="What is AEP?">What is AEP?</button>
    <button type="button" data-question="What does DDP mean?">What does DDP mean?</button>
    <button type="button" data-question="What's the weather like?">Weather</button>
  </div>
  <form id="askForm">
      <button type="button" id="micBtn" aria-label="Speak your question">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="23"></line>
          <line x1="8" y1="23" x2="16" y2="23"></line>
        </svg>
      </button>
      <input type="text" id="question" placeholder="Message The Gaffer..." autocomplete="off" required>
      <button type="submit" id="askBtn" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<dialog id="addInfoDialog">
  <div class="manager-panel">
    <button id="addInfoClose" class="dialog-close" type="button" style="float:right">Close</button>
    <h2>Add info to The Gaffer</h2>

    <div style="display:flex;gap:8px;margin-bottom:14px;">
      <button type="button" id="tabNote" class="add-info-tab active">Paste a quick note</button>
      <button type="button" id="tabFile" class="add-info-tab">Upload a file</button>
      <button type="button" id="tabInvoice" class="add-info-tab">Parse commercial invoice</button>
    </div>

    <div id="notePanel">
      <input type="text" id="noteTitle" placeholder="Short title (e.g. 'New Cork WFS contact')" style="width:100%;margin-bottom:10px;padding:10px;border:1px solid var(--border);border-radius:8px;font-size:14px;">
      <textarea id="noteBody" placeholder="Paste or type the update here..." style="width:100%;height:160px;padding:10px;border:1px solid var(--border);border-radius:8px;font-size:14px;font-family:inherit;resize:vertical;"></textarea>
      <button type="button" id="noteSave" style="margin-top:10px;width:auto;height:38px;border-radius:19px;padding:0 18px;">Save note</button>
      <p id="noteStatus" style="font-size:13px;color:#666;margin-top:8px;"></p>
    </div>

    <div id="filePanel" hidden>
      <p style="font-size:13px;color:#666;margin-bottom:10px;">
        Supports Word (.docx), PDF, Excel (.xlsx), and plain text/markdown/CSV.
        Text is extracted right in your browser, then saved the same way as a note.
      </p>
      <input type="file" id="fileInput" accept=".docx,.pdf,.xlsx,.xls,.txt,.md,.csv">
      <p id="fileStatus" style="font-size:13px;color:#666;margin-top:8px;"></p>
    </div>

    <div id="invoicePanel" hidden>
      <p style="font-size:13px;color:#666;margin-bottom:10px;">
        Upload a commercial invoice (Word or PDF with real text, not a scanned image) to pull out
        tariff codes, country of origin, quantities, and weights per line - with an automatic check
        that the line values add up to the invoice's stated total.
      </p>
      <input type="file" id="invoiceInput" accept=".docx,.pdf,.txt">
      <p id="invoiceStatus" style="font-size:13px;color:#666;margin-top:8px;"></p>
      <pre id="invoiceResult" style="display:none;white-space:pre-wrap;font-family:inherit;font-size:13px;background:#f8fafc;border:1px solid var(--border);border-radius:8px;padding:12px;margin-top:10px;max-height:320px;overflow-y:auto;"></pre>
      <button type="button" id="invoiceCopy" style="display:none;margin-top:8px;width:auto;height:34px;border-radius:17px;padding:0 14px;font-size:12px;">Copy result</button>
    </div>
  </div>
</dialog>

<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
  // ---- Config: fill in your Edge Function URL ----
  const ASK_ENDPOINT = "https://kqxaghuirecpawfpjiwy.supabase.co/functions/v1/ask-ops";

  const chat = document.getElementById("chat");
  const form = document.getElementById("askForm");
  const input = document.getElementById("question");
  const btn = document.getElementById("askBtn");
  const clearChatBtn = document.getElementById("clearChat");
  const conversation = JSON.parse(sessionStorage.getItem("gafferConversation") || "[]");
  let userName = localStorage.getItem("gafferUserName") || "";

  function saveConversation() {
    sessionStorage.setItem("gafferConversation", JSON.stringify(conversation.slice(-12)));
  }

  function askForName() {
    const wrap = document.createElement("div");
    wrap.className = "msg bot";
    const bubble = document.createElement("div");
    bubble.className = "bubble";
    bubble.textContent = "Howya! Before we get started, what's your name?";
    wrap.appendChild(bubble);

    const nameForm = document.createElement("form");
    nameForm.style.cssText = "display:flex;gap:8px;margin-top:10px;";
    nameForm.innerHTML = '<input type="text" placeholder="Your name" autocomplete="given-name" required style="flex:1;padding:8px 12px;border:1px solid #dfe4ec;border-radius:16px;font-size:14px;"><button type="submit" style="background:#548235;color:white;border:none;padding:8px 16px;border-radius:16px;font-size:14px;cursor:pointer;">OK</button>';
    wrap.appendChild(nameForm);
    chat.appendChild(wrap);
    scrollToBottom();

    nameForm.querySelector("input").focus();
    nameForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = nameForm.querySelector("input").value.trim();
      if (!name) return;
      userName = name;
      localStorage.setItem("gafferUserName", name);
      nameForm.remove();
      addMessage("bot", `Great to meet you, ${name}! Ask me about Ops SOPs, policies, shared docs, or just say hello.`);
    });
  }

  document.querySelector("header .avatar").innerHTML = document.querySelector(".hero-avatar").innerHTML;

  if (!userName) {
    askForName();
  }

  function scrollToBottom() {
    chat.scrollTop = chat.scrollHeight;
  }

  async function sendFeedback(rating, question, answer, button) {
    const group = button.parentElement;
    group.querySelectorAll("button").forEach(b => {
      b.disabled = true;
      b.classList.remove("selected");
    });
    button.classList.add("selected");
    try {
      await fetch(ASK_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "feedback", rating, question, answer }),
      });
    } catch (_) {
      // Feedback must never interrupt normal chat.
    }
  }

  function escapeHtml(str) {
    return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function addMessage(role, text, sources, feedbackContext = null) {
    const wrap = document.createElement("div");
    wrap.className = `msg ${role}`;
    const bubble = document.createElement("div");
    bubble.className = "bubble";

    // If the answer mentions a source file by name and we have a real link
    // for it, turn just that mention into a clickable link - inline in the
    // sentence, not as a separate badge row.
    let html = escapeHtml(text);
    if (sources && sources.length) {
      for (const src of sources) {
        const name = typeof src === "string" ? src : src.name;
        const link = typeof src === "string" ? null : src.link;
        if (!link || !name) continue;
        const escapedName = escapeHtml(name);
        const idx = html.indexOf(escapedName);
        if (idx !== -1) {
          html = html.slice(0, idx) +
            `<a href="${link}" target="_blank" rel="noopener">${escapedName}</a>` +
            html.slice(idx + escapedName.length);
        }
      }
    }
    bubble.innerHTML = html;
    wrap.appendChild(bubble);

    if (role === "bot" && feedbackContext) {
      const feedback = document.createElement("div");
      feedback.className = "feedback";
      feedback.innerHTML = '<button type="button" aria-label="Helpful">👍 Helpful</button><button type="button" aria-label="Not helpful">👎 Not helpful</button><button type="button" aria-label="Flag for manager review">🚩 Flag for review</button>';
      const buttons = feedback.querySelectorAll("button");
      buttons[0].addEventListener("click", () => sendFeedback("up", feedbackContext.question, text, buttons[0]));
      buttons[1].addEventListener("click", () => sendFeedback("down", feedbackContext.question, text, buttons[1]));
      buttons[2].addEventListener("click", () => sendFeedback("review", feedbackContext.question, text, buttons[2]));
      wrap.appendChild(feedback);
    }

    if (role === "bot") {
      const actions = document.createElement("div");
      actions.className = "message-actions";
      actions.innerHTML = '<button type="button">Copy</button><button type="button">Email</button>';
      actions.children[0].addEventListener("click", async () => {
        await navigator.clipboard.writeText(text);
        actions.children[0].textContent = "Copied";
      });
      actions.children[1].addEventListener("click", () => {
        const subject = encodeURIComponent("The Gaffer answer");
        const body = encodeURIComponent(text);
        window.location.href = `mailto:?subject=${subject}&body=${body}`;
      });
      wrap.appendChild(actions);
    }

    chat.appendChild(wrap);
    scrollToBottom();
    return wrap;
  }

  function addTyping() {
    const wrap = document.createElement("div");
    wrap.className = "msg bot";
    wrap.innerHTML = `<div class="typing"><span></span><span></span><span></span></div>`;
    chat.appendChild(wrap);
    scrollToBottom();
    return wrap;
  }

  // ---- Add info dialog: quick notes and file uploads ----
  const addInfoBtn = document.getElementById("addInfoBtn");
  const addInfoDialog = document.getElementById("addInfoDialog");
  const addInfoClose = document.getElementById("addInfoClose");
  const tabNote = document.getElementById("tabNote");
  const tabFile = document.getElementById("tabFile");
  const notePanel = document.getElementById("notePanel");
  const filePanel = document.getElementById("filePanel");
  const noteTitle = document.getElementById("noteTitle");
  const noteBody = document.getElementById("noteBody");
  const noteSave = document.getElementById("noteSave");
  const noteStatus = document.getElementById("noteStatus");
  const fileInput = document.getElementById("fileInput");
  const fileStatus = document.getElementById("fileStatus");
  const tabInvoice = document.getElementById("tabInvoice");
  const invoicePanel = document.getElementById("invoicePanel");
  const invoiceInput = document.getElementById("invoiceInput");
  const invoiceStatus = document.getElementById("invoiceStatus");
  const invoiceResult = document.getElementById("invoiceResult");
  const invoiceCopy = document.getElementById("invoiceCopy");

  addInfoBtn?.addEventListener("click", () => addInfoDialog.showModal());
  addInfoClose?.addEventListener("click", () => addInfoDialog.close());

  function showTab(activeTab) {
    for (const [tab, panel] of [[tabNote, notePanel], [tabFile, filePanel], [tabInvoice, invoicePanel]]) {
      const isActive = tab === activeTab;
      tab.classList.toggle("active", isActive);
      panel.hidden = !isActive;
    }
  }
  tabNote?.addEventListener("click", () => showTab(tabNote));
  tabFile?.addEventListener("click", () => showTab(tabFile));
  tabInvoice?.addEventListener("click", () => showTab(tabInvoice));

  async function saveToGaffer(fileName, content, statusEl) {
    statusEl.textContent = "Saving...";
    try {
      const res = await fetch(ASK_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "upload_doc", fileName, content }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        statusEl.textContent = "Error: " + (data.error || `HTTP ${res.status}`);
        return false;
      }
      statusEl.textContent = `Saved (${data.chunksAdded} chunk${data.chunksAdded === 1 ? "" : "s"}). The Gaffer can use this right away.`;
      return true;
    } catch (err) {
      statusEl.textContent = "Couldn't reach the server. Try again in a moment.";
      return false;
    }
  }

  noteSave?.addEventListener("click", async () => {
    const title = noteTitle.value.trim() || `Quick Note - ${new Date().toLocaleDateString()}`;
    const body = noteBody.value.trim();
    if (!body) {
      noteStatus.textContent = "Type something first.";
      return;
    }
    const ok = await saveToGaffer(`${title}.txt`, body, noteStatus);
    if (ok) {
      noteTitle.value = "";
      noteBody.value = "";
    }
  });

  async function extractTextFromFile(file) {
    const ext = file.name.split(".").pop().toLowerCase();
    if (ext === "docx") {
      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      return result.value;
    } else if (ext === "pdf") {
      const arrayBuffer = await file.arrayBuffer();
      pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      const pageTexts = [];
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        pageTexts.push(content.items.map((item) => item.str).join(" "));
      }
      return pageTexts.join("\n\n");
    } else if (ext === "xlsx" || ext === "xls") {
      const arrayBuffer = await file.arrayBuffer();
      const wb = XLSX.read(arrayBuffer, { type: "array" });
      const sheetTexts = wb.SheetNames.map((name) => {
        const csv = XLSX.utils.sheet_to_csv(wb.Sheets[name]);
        return `## Sheet: ${name}\n${csv}`;
      });
      return sheetTexts.join("\n\n");
    } else {
      return await file.text();
    }
  }

  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files[0];
    if (!file) return;
    fileStatus.textContent = "Reading file...";

    try {
      const text = await extractTextFromFile(file);

      if (!text.trim()) {
        fileStatus.textContent = "Couldn't find any text in that file - it may be a scanned/image-based document.";
        return;
      }

      await saveToGaffer(file.name, text, fileStatus);
    } catch (err) {
      fileStatus.textContent = "Couldn't read that file: " + err.message;
    }
  });

  invoiceInput?.addEventListener("change", async () => {
    const file = invoiceInput.files[0];
    if (!file) return;
    invoiceResult.style.display = "none";
    invoiceCopy.style.display = "none";
    invoiceStatus.textContent = "Reading file...";

    try {
      const text = await extractTextFromFile(file);
      if (!text.trim()) {
        invoiceStatus.textContent = "Couldn't find any text in that file - it may be a scanned/image-based document (not supported here yet).";
        return;
      }

      invoiceStatus.textContent = "Parsing invoice...";
      const res = await fetch(ASK_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "parse_invoice", content: text }),
      });
      const data = await res.json();
      if (!res.ok || data.error) {
        invoiceStatus.textContent = "Error: " + (data.error || `HTTP ${res.status}`);
        return;
      }
      invoiceStatus.textContent = "";
      invoiceResult.textContent = data.answer;
      invoiceResult.style.display = "block";
      invoiceCopy.style.display = "inline-block";
    } catch (err) {
      invoiceStatus.textContent = "Couldn't read that file: " + err.message;
    }
  });

  invoiceCopy?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(invoiceResult.textContent);
    invoiceCopy.textContent = "Copied";
    setTimeout(() => { invoiceCopy.textContent = "Copy result"; }, 1500);
  });

  clearChatBtn?.addEventListener("click", () => {
    conversation.length = 0;
    saveConversation();
    chat.innerHTML = "";
    addMessage("bot", "Fresh start. What can I help you with?");
    input.focus();
  });

  const micBtn = document.getElementById("micBtn");
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (SR) {
    const recognition = new SR();
    recognition.lang = "en-IE";
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;
    let listening = false;

    micBtn.addEventListener("click", () => {
      if (listening) return;
      listening = true;
      micBtn.classList.add("listening");
      recognition.start();
    });
    recognition.onresult = (e) => {
      input.value = e.results[0][0].transcript;
      form.requestSubmit();
    };
    recognition.onerror = () => {
      listening = false;
      micBtn.classList.remove("listening");
    };
    recognition.onend = () => {
      listening = false;
      micBtn.classList.remove("listening");
    };
  } else {
    micBtn.addEventListener("click", () => {
      addMessage("bot", "Voice input isn't supported in this browser. Try Chrome or Edge.");
    });
  }


  document.querySelectorAll(".quick-prompts button").forEach(button => {
    button.addEventListener("click", () => {
      input.value = button.dataset.question || "";
      form.requestSubmit();
    });
  });

  if (conversation.length) {
    chat.innerHTML = "";
    conversation.forEach(turn => addMessage(turn.role === "assistant" ? "bot" : "user", turn.content));
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;

    addMessage("user", question);
    input.value = "";
    btn.disabled = true;
    const typingEl = addTyping();

    try {
      const res = await fetch(ASK_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          question,
          history: conversation.slice(-8),
          userName,
        }),
      });
      const data = await res.json();
      typingEl.remove();

      if (!res.ok || data.error) {
        addMessage("bot", "Something went wrong: " + (data.error || `HTTP ${res.status}`));
      } else {
        addMessage("bot", data.answer, data.sources, { question });
        conversation.push(
          { role: "user", content: question },
          { role: "assistant", content: data.answer }
        );
        if (conversation.length > 12) conversation.splice(0, conversation.length - 12);
        saveConversation();
      }
    } catch (err) {
      typingEl.remove();
      addMessage("bot", "Couldn't reach the server. Try again in a moment.");
    } finally {
      btn.disabled = false;
      input.focus();
    }
  });
</script>


</body>
</html>
