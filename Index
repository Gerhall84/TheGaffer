// ---- Route planner (point-to-point distance/drive time) ----
async function geocode(place: string): Promise<{ lat: number; lon: number; label: string } | null> {
  try {
    const res = await fetch(
      `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(place)}&format=json&limit=1`,
      { headers: { "User-Agent": "MauriceWardOpsGaffer/1.0 (internal ops tool)" } }
    );
    const data = await res.json();
    if (!Array.isArray(data) || data.length === 0) return null;
    return { lat: parseFloat(data[0].lat), lon: parseFloat(data[0].lon), label: data[0].display_name };
  } catch (_e) {
    return null;
  }
}

function extractRouteLocations(question: string): { origin: string; destination: string } | null {
  const patterns = [
    /(?:from|between)\s+(.+?)\s+(?:to|and)\s+(.+?)(?:\?|$)/i,
    /(?:route|drive|distance|directions)\s+(.+?)\s+to\s+(.+?)(?:\?|$)/i,
  ];
  for (const re of patterns) {
    const match = question.match(re);
    if (match) return { origin: match[1].trim(), destination: match[2].trim() };
  }
  return null;
}

// EU drivers' hours rules (Regulation 561/2006), applied to the raw driving
// time to give realistic route options rather than just a bare duration.
// Standard rules: max 9h driving/day (extendable to 10h up to twice/week),
// mandatory 45-min break after every 4.5h of accumulated driving.
function driverHoursNote(durationSeconds: number): string {
  const hours = durationSeconds / 3600;
  const breaksNeeded = Math.floor(hours / 4.5);
  const totalWithBreaksMin = Math.round(durationSeconds / 60) + breaksNeeded * 45;
  const twh = Math.floor(totalWithBreaksMin / 60);
  const twm = totalWithBreaksMin % 60;
  const totalWithBreaksStr = `${twh}h ${twm}m`;

  if (hours <= 4.5) {
    return "Single driver, no mandatory break required under EU drivers' hours rules - straightforward same-day route.";
  }
  if (hours <= 9) {
    return `Feasible for one driver in a single day, but EU rules require at least ${breaksNeeded} break${breaksNeeded > 1 ? "s" : ""} of 45 minutes after every 4.5h of driving. Total time including break(s): approximately ${totalWithBreaksStr}.`;
  }
  if (hours <= 10) {
    return `This exceeds the standard 9-hour daily driving limit, but fits within the extended 10-hour limit (usable up to twice per week per driver - confirm the driver hasn't already used both extensions this week). Needs ${breaksNeeded} break${breaksNeeded > 1 ? "s" : ""} of 45 minutes; total time including breaks: approximately ${totalWithBreaksStr}.`;
  }
  return `This exceeds even the extended 10-hour daily driving limit for a single driver. Realistic options: split the route over two days with a qualifying rest stop overnight, or use a second/team driver so driving hours are shared.`;
}

async function getRoute(question: string): Promise<string | null> {
  const locations = extractRouteLocations(question);
  if (!locations) return null;

  const [origin, destination] = await Promise.all([
    geocode(locations.origin),
    geocode(locations.destination),
  ]);
  if (!origin || !destination) return null;

  try {
    const res = await fetch(
      `https://router.project-osrm.org/route/v1/driving/${origin.lon},${origin.lat};${destination.lon},${destination.lat}?overview=false`
    );
    const data = await res.json();
    const route = data?.routes?.[0];
    if (!route) return null;

    const km = (route.distance / 1000).toFixed(0);
    const totalMinutes = Math.round(route.duration / 60);
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    const timeStr = hours > 0 ? `${hours}h ${minutes}m` : `${minutes} min`;

    const hoursNote = driverHoursNote(route.duration);

    return `${locations.origin} to ${locations.destination}: approximately ${km} km by road, ${timeStr} pure driving time (excludes traffic, ferries, and border/customs stops).\n\n${hoursNote}\n\n(Based on standard EU drivers' hours rules - check the tachograph/driver hours reference doc or Transport team for your specific compliance situation.)`;
  } catch (_e) {
    return null;
  }
}

async function getPastNegativeFeedback(question: string): Promise<string | null> {
  try {
    const { data, error } = await supabase
      .from("chat_feedback")
      .select("answer")
      .eq("rating", "down")
      .ilike("question", question.trim())
      .order("created_at", { ascending: false })
      .limit(1);
    if (error || !data || data.length === 0) return null;
    return data[0].answer;
  } catch (_e) {
    return null;
  }
}

// ---- Direct upload: chunk, hash, and embed text sent straight from the chat page ----
async function computeContentHash(text: string): Promise<string> {
  const data = new TextEncoder().encode(text);
  const hashBuffer = await crypto.subtle.digest("SHA-256", data);
  return Array.from(new Uint8Array(hashBuffer)).map((b) => b.toString(16).padStart(2, "0")).join("");
}

function chunkPlainText(text: string, size = 1500): string[] {
  const lines = text.split("\n").map((l) => l.trim()).filter(Boolean);
  const chunks: string[] = [];
  let current = "";
  let currentHeading: string | null = null;

  function flush() {
    if (current) {
      chunks.push(currentHeading && !current.startsWith(currentHeading) ? `${currentHeading}\n${current}` : current);
      current = "";
    }
  }

  for (const line of lines) {
    if (line.startsWith("## ")) {
      flush();
      currentHeading = line;
      current = line;
      continue;
    }
    if (current.length + line.length + 1 > size && current) {
      flush();
      current = line;
    } else {
      current = current ? `${current}\n${line}` : line;
    }
  }
  flush();
  return chunks;
}

async function embedForUpload(chunks: string[]): Promise<(number[] | null)[]> {
  if (!VOYAGE_API_KEY || chunks.length === 0) return chunks.map(() => null);
  try {
    const res = await fetch("https://api.voyageai.com/v1/embeddings", {
      method: "POST",
      headers: { "Authorization": `Bearer ${VOYAGE_API_KEY}`, "Content-Type": "application/json" },
      body: JSON.stringify({ input: chunks, model: "voyage-3.5", input_type: "document", output_dimension: 1024 }),
    });
    const data = await res.json();
    return data?.data?.map((d: any) => d.embedding) || chunks.map(() => null);
  } catch (_e) {
    return chunks.map(() => null);
  }
}

function formatEmbeddingForPg(vec: number[] | null): string | null {
  return vec ? "[" + vec.join(",") + "]" : null;
}

async function askClaude(opts: {
  system: string;
  history: { role: string; content: string }[];
  userContent: string;
  maxTokens?: number;
  allowWebSearch?: boolean;
  webSearchUses?: number;
}): Promise<string> {
  const body: Record<string, unknown> = {
    model: "claude-sonnet-4-6",
    max_tokens: opts.maxTokens ?? 250,
    system: opts.system,
    messages: [...opts.history, { role: "user", content: opts.userContent }],
  };
  if (opts.allowWebSearch) {
    body.tools = [{ type: "web_search_20250305", name: "web_search", max_uses: opts.webSearchUses ?? 1 }];
  }
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": ANTHROPIC_API_KEY,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  return data?.content?.map((b: any) => (b.type === "text" ? b.text : "")).join("\n").trim() || "";
}

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: CORS_HEADERS });
  }

  let body: any;
  try {
    body = await req.json();
  } catch (_e) {
    return json({ error: "Invalid request body" }, 400);
  }

  try {
    // ---- Feedback: thumbs up/down/review-flag on a specific answer ----
    if (body.action === "feedback") {
      const rating = ["up", "down", "review"].includes(body.rating) ? body.rating : null;
      if (!rating || typeof body.question !== "string" || typeof body.answer !== "string") {
        return json({ error: "Missing rating/question/answer" }, 400);
      }
      await supabase.from("chat_feedback").insert({
        question: body.question,
        answer: body.answer,
        rating,
      });
      return json({ ok: true });
    }

    // ---- Direct upload: quick notes or text extracted from a file in the browser ----
    // ---- Commercial invoice parser ----
    if (body.action === "parse_invoice") {
      const content = typeof body.content === "string" ? body.content.trim() : "";
      if (!content) return json({ error: "Missing invoice text" }, 400);

      const extractionPrompt =
        "Extract structured data from this commercial invoice. Respond with ONLY valid JSON, " +
        "no markdown fences, no prose before or after. Use this exact schema:\n" +
        `{
  "invoice_number": string or null,
  "invoice_date": string or null,
  "currency": string or null (3-letter code if identifiable, e.g. EUR, USD, GBP),
  "total_value_stated": number or null (the invoice's own stated grand total, if shown),
  "total_net_weight_kg_stated": number or null (only if the invoice states an overall net weight, not per-line),
  "total_gross_weight_kg_stated": number or null (only if the invoice states an overall gross weight, not per-line),
  "line_items": [
    {
      "description": string,
      "hs_code": string or null (tariff/HS/commodity code),
      "country_of_origin": string or null,
      "quantity": number or null,
      "unit": string or null,
      "unit_value": number or null,
      "line_value": number or null (quantity * unit_value, or as stated),
      "net_weight_kg": number or null (ONLY if stated per-line - do not calculate or guess, leave null if not explicitly given per-line),
      "gross_weight_kg": number or null (same rule as net_weight_kg)
    }
  ]
}` +
        "\n\nBe precise - do not invent numbers that aren't in the document. If a field genuinely isn't present, use null.";

      const claudeRes = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": ANTHROPIC_API_KEY,
          "anthropic-version": "2023-06-01",
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-6",
          max_tokens: 2000,
          temperature: 0,
          system: extractionPrompt,
          messages: [{ role: "user", content: `Invoice text:\n\n${content}` }],
        }),
      });
      const claudeData = await claudeRes.json();
      const rawText = claudeData?.content?.map((b: any) => (b.type === "text" ? b.text : "")).join("").trim() || "";

      let parsed: any;
      try {
        const cleaned = rawText.replace(/^```json\s*/i, "").replace(/```\s*$/, "").trim();
        parsed = JSON.parse(cleaned);
      } catch (_e) {
        return json({ error: "Couldn't parse the invoice into structured data - the format may be too unusual. Try a clearer copy or check manually." }, 500);
      }

      const lineItems: any[] = Array.isArray(parsed.line_items) ? parsed.line_items : [];

      // Deterministic value reconciliation - NEVER trust the LLM's own stated
      // total, always recompute from the actual line items in code
      const computedTotal = lineItems.reduce((sum, li) => sum + (Number(li.line_value) || 0), 0);
      const statedTotal = Number(parsed.total_value_stated);
      let valueWarning: string | null = null;
      if (!isNaN(statedTotal) && statedTotal > 0) {
        const diff = Math.abs(computedTotal - statedTotal);
        const tolerance = Math.max(statedTotal * 0.01, 0.5); // 1% or 0.50, whichever is bigger
        if (diff > tolerance) {
          valueWarning = `⚠️ MANUAL CHECK NEEDED: line items sum to ${computedTotal.toFixed(2)}, but the invoice states a total of ${statedTotal.toFixed(2)} (difference: ${diff.toFixed(2)}). This could mean a line was misread, a discount/freight charge isn't itemized, or the total on the invoice includes something not in the line items.`;
        }
      }

      // Deterministic weight-splitting - only apportion when a line is missing
      // its own weight AND an overall total was stated; apportioned values are
      // clearly marked as calculated, not as stated on the document
      function apportionWeight(field: "net_weight_kg" | "gross_weight_kg", totalStatedField: string) {
        const totalStated = Number(parsed[totalStatedField]);
        if (isNaN(totalStated) || totalStated <= 0) return;
        const missingLines = lineItems.filter((li) => li[field] == null);
        if (missingLines.length === 0) return;
        const knownSum = lineItems.reduce((sum, li) => sum + (li[field] != null ? Number(li[field]) : 0), 0);
        const remaining = totalStated - knownSum;
        if (remaining <= 0) return;
        const valueBasis = missingLines.reduce((sum, li) => sum + (Number(li.line_value) || 0), 0);
        for (const li of missingLines) {
          const share = valueBasis > 0 ? (Number(li.line_value) || 0) / valueBasis : 1 / missingLines.length;
          li[field] = Number((remaining * share).toFixed(2));
          li[`${field}_apportioned`] = true;
        }
      }
      apportionWeight("net_weight_kg", "total_net_weight_kg_stated");
      apportionWeight("gross_weight_kg", "total_gross_weight_kg_stated");

      const lines = lineItems.map((li, i) => {
        const netStr = li.net_weight_kg != null ? `${li.net_weight_kg}kg${li.net_weight_kg_apportioned ? " (apportioned)" : ""}` : "n/a";
        const grossStr = li.gross_weight_kg != null ? `${li.gross_weight_kg}kg${li.gross_weight_kg_apportioned ? " (apportioned)" : ""}` : "n/a";
        return `${i + 1}. ${li.description || "(no description)"} | HS: ${li.hs_code || "n/a"} | Origin: ${li.country_of_origin || "n/a"} | Qty: ${li.quantity ?? "n/a"} ${li.unit || ""} | Value: ${li.line_value ?? "n/a"} | Net: ${netStr} | Gross: ${grossStr}`;
      });

      const currency = parsed.currency || "";
      const summary =
        `Invoice ${parsed.invoice_number || "(no number found)"}${parsed.invoice_date ? `, dated ${parsed.invoice_date}` : ""}\n\n` +
        lines.join("\n") +
        `\n\nLine items total: ${currency} ${computedTotal.toFixed(2)}` +
        (parsed.total_value_stated != null ? ` (invoice states: ${currency} ${Number(parsed.total_value_stated).toFixed(2)})` : "") +
        (valueWarning ? `\n\n${valueWarning}` : "\n\n✓ Line items match the stated invoice total.");

      return json({ answer: summary, sources: [], invoiceData: parsed });
    }

    if (body.action === "upload_doc") {
      const fileName = typeof body.fileName === "string" ? body.fileName.trim() : "";
      const content = typeof body.content === "string" ? body.content.trim() : "";
      if (!fileName || !content) {
        return json({ error: "Missing fileName or content" }, 400);
      }
      if (content.length < 10) {
        return json({ error: "That looks too short to be useful - nothing saved." }, 400);
      }

      const filePath = `Direct Uploads/${fileName}`;
      const hash = await computeContentHash(content);

      // Clear any previous version of this same upload first (supports re-uploading an update)
      await supabase.from("doc_chunks").delete().eq("file_path", filePath);
      await supabase.from("doc_files").delete().eq("file_path", filePath);

      const chunks = chunkPlainText(content);
      const embeddings = await embedForUpload(chunks);
      const rows = chunks.map((c, i) => ({
        file_path: filePath,
        file_name: fileName,
        chunk_index: i,
        content: c,
        file_hash: hash,
        embedding: formatEmbeddingForPg(embeddings[i]),
      }));

      const { error: insertError } = await supabase.from("doc_chunks").insert(rows);
      if (insertError) return json({ error: insertError.message }, 500);

      await supabase.from("doc_files").insert({ file_path: filePath, file_hash: hash, chunk_count: rows.length });

      return json({ ok: true, chunksAdded: rows.length });
    }

    // ---- Manager dashboard: stats gated by the manager code phrase ----
    if (body.action === "manager") {
      const code = typeof body.code === "string" ? body.code.trim().toLowerCase() : "";
      if (!MANAGER_CODE_WORD || code !== MANAGER_CODE_WORD.trim().toLowerCase()) {
        return json({ error: "Incorrect code" }, 401);
      }
      const [
        { count: totalQuestions },
        { count: helpful },
        { count: unhelpful },
        { data: topQuestions },
        { data: unansweredQuestions },
        { data: unhelpfulRows },
        { data: reviewRows },
      ] = await Promise.all([
        supabase.from("chat_logs").select("*", { count: "exact", head: true }),
        supabase.from("chat_feedback").select("*", { count: "exact", head: true }).eq("rating", "up"),
        supabase.from("chat_feedback").select("*", { count: "exact", head: true }).eq("rating", "down"),
        supabase.rpc("get_top_questions", { result_limit: 10 }),
        supabase.rpc("get_unanswered_questions", { result_limit: 10 }),
        supabase.from("chat_feedback").select("question, answer, created_at").eq("rating", "down").order("created_at", { ascending: false }).limit(10),
        supabase.rpc("get_review_questions_all", { result_limit: 20 }),
      ]);
      // Combine "no docs found at all" gaps with "docs matched but still rated
      // unhelpful" gaps - both are useful signals, but different problems:
      // the first needs new content, the second means existing content isn't
      // clear/complete enough even though it was found.
      const combinedGaps = [
        ...(unansweredQuestions || []).map((r: any) => ({ question: r.question, type: "no_match" })),
        ...(unhelpfulRows || []).map((r: any) => ({ question: r.question, type: "unhelpful" })),
      ];
      return json({
        totalQuestions: totalQuestions || 0,
        helpful: helpful || 0,
        unhelpful: unhelpful || 0,
        topQuestions: topQuestions || [],
        unansweredQuestions: combinedGaps,
        reviewQuestions: reviewRows || [],
      });
    }

    // ---- Normal chat turn ----
    const question = body.question;
    if (!question || typeof question !== "string") {
      return json({ error: "Missing 'question'" }, 400);
    }
    const historyMessages = historyToMessages(body.history);
    const userName = typeof body.userName === "string" ? body.userName.trim().slice(0, 60) : "";
    const nameNote = userName ? ` The person's name is ${userName} - you can address them by name occasionally, but don't overdo it every message.` : "";
    const pastNegativeAnswer = await getPastNegativeFeedback(question);
    const negativeFeedbackNote = pastNegativeAnswer
      ? `\n\nIMPORTANT: A previous answer to this exact question was rated UNHELPFUL by a team member: "${pastNegativeAnswer}" Do not repeat that same answer. Reconsider the material and try a genuinely different angle, more detail, or be honest if you're not confident - don't just reword the same unhelpful answer.`
      : "";

    // Weather chit-chat: quick, friendly, no doc search needed
    if (/\b(weather|forecast|raining|is it cold|is it hot|temperature outside)\b/i.test(question)) {
      const weatherLine = await getWeather();
      const answer = await askClaude({
        system:
          "You are The Gaffer, a warm, friendly, slightly chatty Irish workmate character for the Maurice Ward Ops team. " +
          "Give a short, casual, conversational reply about the weather using the data given - a line or two, not a forecast report." + nameNote,
        history: historyMessages,
        userContent: weatherLine
          ? `Someone asked: "${question}". Here's the current data: ${weatherLine} Answer them casually.`
          : `Someone asked about the weather but the live weather lookup failed. Let them know casually you couldn't check it right now.`,
        maxTokens: 200,
      });
      return json({ answer: answer || weatherLine || "Couldn't check the weather just now, sorry!", sources: [] });
    }

    // Currency exchange: dedicated fast path via a real FX API (ECB rates)
    if (/exchange rate|convert.*(to|into)|how much is.*in (euro|dollar|pound|yen)/i.test(question)) {
      const currencies = extractCurrencies(question);
      if (currencies.length >= 1) {
        const from = currencies[0];
        const to = currencies[1] || "EUR";
        const rateLine = await getExchangeRate(from, to);
        if (rateLine) return json({ answer: rateLine, sources: [] });
      }
    }

    // Irish public holidays: dedicated fast path via a free holiday API
    if (/public holiday|bank holiday/i.test(question) && /next|upcoming|when/i.test(question)) {
      const holidayLine = await getNextIrishHoliday();
      if (holidayLine) return json({ answer: holidayLine, sources: [] });
    }

    // Handler rate calculator: "400kg air export for WFS" / "what's the import charge for 250kg with Swissport"
    if (/\d+\s*kgs?\b/i.test(question) && /import|export/i.test(question)) {
      const rateAnswer = await getHandlerRateAnswer(question);
      if (rateAnswer) return json({ answer: rateAnswer, sources: [] });
      // If we couldn't identify a known handler, fall through to the normal
      // pipeline rather than dead-ending
    }

    // Crate/vehicle fit checker: "will a 120x100x150cm crate fit in the Shannon truck"
    if (/fit/i.test(question) && /\d+\s*(?:cm|m|mm)?\s*x\s*\d+/i.test(question)) {
      const fitAnswer = await getCrateFitAnswer(question);
      if (fitAnswer) return json({ answer: fitAnswer, sources: [] });
      // If we couldn't parse dimensions or identify a known vehicle, fall
      // through to the normal pipeline rather than dead-ending
    }

    // Route planner: point-to-point distance/drive time between two places
    if (/(route|distance|directions|drive|driving).{0,20}(from|between|to)/i.test(question)) {
      const routeLine = await getRoute(question);
      if (routeLine) return json({ answer: routeLine, sources: [] });
      // If we couldn't parse locations or geocode failed, fall through to
      // the normal pipeline below rather than dead-ending
    }

    // Manager code-word shortcut said IN CHAT (kept alongside the dedicated
    // manager dialog above, in case someone prefers typing it naturally)
    if (MANAGER_CODE_WORD && question.toLowerCase().includes(MANAGER_CODE_WORD.toLowerCase())) {
      const wantsGaps = /gap|unanswered|missing|no answer/i.test(question);
      const wantsReview = /review/i.test(question);
      const NOT_A_NAME = new Set(["top", "gap", "gaps", "unanswered", "missing", "review", "flagged", "manager", "frequent", "frequently", "asked", "these", "those", "recent"]);
      const userLookupMatch = question.match(/what\s+(?:has|have|did)\s+([a-zA-Z]+)\s+(?:asked|asking)/i)
        || question.match(/what\s+([a-zA-Z]+)\s+(?:has|have)\s+(?:asked|asking)/i)
        || (() => {
          const m = question.match(/what\s+([a-zA-Z]+)\s+asked/i);
          return m && !NOT_A_NAME.has(m[1].toLowerCase()) ? m : null;
        })()
        || (() => {
          const m = question.match(/([a-zA-Z]+)(?:'s)?\s+questions/i);
          return m && !NOT_A_NAME.has(m[1].toLowerCase()) ? m : null;
        })();
      if (wantsReview) {
        const isToday = /today/i.test(question);
        const { data, error } = await supabase.rpc(
          isToday ? "get_review_questions_today" : "get_review_questions_all",
          { result_limit: 20 }
        );
        if (error) throw error;
        const list = (data || [])
          .map((r: any, i: number) => `${i + 1}. "${r.question}"\n   Answer given: "${r.answer}"`)
          .join("\n\n");
        return json({
          answer: list
            ? `${isToday ? "Today's" : "All"} flagged-for-review questions:\n\n${list}`
            : `No questions flagged for review ${isToday ? "today" : "yet"}.`,
          sources: [],
        });
      } else if (wantsGaps) {
        const { data, error } = await supabase.rpc("get_unanswered_questions", { result_limit: 10 });
        if (error) throw error;
        const list = (data || []).map((r: any, i: number) => `${i + 1}. "${r.question}"`).join("\n");
        return json({
          answer: list ? `Recent questions that found nothing in the docs:\n\n${list}` : "No unanswered questions logged yet - looking good.",
          sources: [],
        });
      } else if (userLookupMatch) {
        const name = userLookupMatch[1];
        const { data, error } = await supabase.rpc("get_questions_by_user", { name_query: name, result_limit: 20 });
        if (error) throw error;
        const list = (data || [])
          .map((r: any, i: number) => `${i + 1}. "${r.question}" (${new Date(r.asked_at).toLocaleString()})`)
          .join("\n");
        return json({
          answer: list
            ? `Questions asked by ${name}:\n\n${list}`
            : `No questions logged from anyone named "${name}" yet - they may not have given their name to The Gaffer, or haven't asked anything logged.`,
          sources: [],
        });
      } else {
        const { data, error } = await supabase.rpc("get_top_questions", { result_limit: 10 });
        if (error) throw error;
        const list = (data || [])
          .map((r: any, i: number) => `${i + 1}. "${r.question}" - asked ${r.times_asked} time${r.times_asked === 1 ? "" : "s"}`)
          .join("\n");
        return json({
          answer: list ? `Most frequently asked questions:\n\n${list}` : "No questions logged yet.",
          sources: [],
        });
      }
    }

    // Expand any recognised domain shorthand (ETA, AWB, HS code, etc.)
    const abbrevExpansion = expandAbbreviations(question);
    const enrichedQuestion = abbrevExpansion.length ? `${question} (${abbrevExpansion.join(" ")})` : question;

    const stopwords = new Set(["the","a","an","is","are","was","were","what","whats","how","do","does","did","for","of","in","on","at","to","and","or","my","our","i","we","you","your"]);
    const baseWords = question
      .toLowerCase()
      .replace(/[^a-z0-9\s]/g, " ")
      .split(/\s+/)
      .filter((w: string) => w.length > 2 && !stopwords.has(w));
    const words = [...new Set([...baseWords, ...abbrevExpansion])];

    async function runSemanticSearch(): Promise<any[]> {
      if (!VOYAGE_API_KEY) return [];
      try {
        const embedRes = await fetch("https://api.voyageai.com/v1/embeddings", {
          method: "POST",
          headers: { "Authorization": `Bearer ${VOYAGE_API_KEY}`, "Content-Type": "application/json" },
          body: JSON.stringify({ input: [enrichedQuestion], model: "voyage-3.5", input_type: "query", output_dimension: 1024 }),
        });
        const embedData = await embedRes.json();
        const queryEmbedding = embedData?.data?.[0]?.embedding;
        if (!queryEmbedding) return [];
        const { data, error } = await supabase.rpc("search_doc_chunks_semantic", { query_embedding: queryEmbedding, match_limit: 8 });
        return error ? [] : (data || []);
      } catch (_e) {
        return [];
      }
    }

    async function runKeywordSearch(): Promise<any[]> {
      if (words.length === 0) return [];
      const { data, error } = await supabase.rpc("search_doc_chunks", { search_query: words.join(" | "), match_limit: 8 });
      return error ? [] : (data || []);
    }

    const [semanticChunks, keywordChunks] = await Promise.all([runSemanticSearch(), runKeywordSearch()]);

    const seen = new Set<string>();
    let chunks: any[] = [];
    for (const c of [...semanticChunks, ...keywordChunks]) {
      const key = `${c.file_name}::${c.content.slice(0, 80)}`;
      if (!seen.has(key)) {
        seen.add(key);
        chunks.push(c);
      }
    }
    chunks = chunks.slice(0, 10);

    const fuzzyWords = baseWords.filter((w: string) => w.length >= 4);
    if (chunks.length === 0 && fuzzyWords.length > 0) {
      const { data } = await supabase.rpc("search_doc_chunks_fuzzy", { search_words: fuzzyWords, match_limit: 8 });
      chunks = data || [];
    }

    // Fire-and-forget logging - doesn't block the response
    const sourcesForLog = [...new Set(chunks.map((c: any) => c.file_name))];
    supabase.from("chat_logs").insert({ question, matched_chunks: chunks.length, sources: sourcesForLog, user_name: userName || null }).then(() => {}, () => {});

    if (!chunks || chunks.length === 0) {
      const answer = await askClaude({
        system:
          "You are The Gaffer, a warm, friendly, slightly chatty Irish workmate character for the Maurice Ward Ops team. " +
          "No matching internal Ops documents were found for this message. " +
          "KEEP IT SHORT: 1-3 sentences, just the direct answer, no extra padding or caveats piled on. " +
          "If it's genuine small talk or banter, respond naturally and warmly like a friendly colleague - do NOT search the web for this. " +
          "If it's a general shipping, logistics, Irish customs, or freight forwarding CONCEPT that you already know " +
          "and isn't specific to Maurice Ward's own procedures, answer it briefly from your own knowledge - " +
          "do NOT search the web for stable definitional concepts, only use your existing knowledge. " +
          "Use the web_search tool for genuinely current/time-sensitive things: today's exchange rate, a " +
          "current tariff/duty change, a live port strike or shipping alert, this week's Revenue.ie announcement, " +
          "current fuel surcharge levels, AND ALSO general news, sports results/fixtures, and weather. For Irish " +
          "news, sport, or weather questions, prefer RTE News (rte.ie/news) or Sky News (news.sky.com) as the source. " +
          "If it's a real question specifically about how Maurice Ward does something and it just isn't " +
          "covered in the docs, say so plainly and briefly and suggest a colleague or SOP owner, " +
          "without guessing at internal policy or searching the web for internal-only information. " +
          "Use the conversation history to understand follow-up questions and pronouns (e.g. 'what about for road freight instead')." + nameNote,
        history: historyMessages,
        userContent: question + negativeFeedbackNote,
        maxTokens: 250,
        allowWebSearch: true,
        webSearchUses: 1,
      });
      return json({ answer: answer || "I couldn't find anything in the shared folder that matches that question.", sources: [] });
    }

    const contextBlock = chunks.map((c: any, i: number) => `[Source ${i + 1}: ${c.file_name}]\n${c.content}`).join("\n\n---\n\n");

    const seenFiles = new Set<string>();
    const sources: { name: string; link: string | null }[] = [];
    for (const c of chunks) {
      if (!seenFiles.has(c.file_name)) {
        seenFiles.add(c.file_name);
        sources.push({ name: c.file_name, link: c.web_url || null });
      }
    }

    const answer = await askClaude({
      system:
        "You are The Gaffer, a warm, friendly Irish workmate character for the Maurice Ward Ops team. " +
        "Answer primarily using the provided document excerpts, in a natural, conversational tone - not corporate or robotic. " +
        "KEEP ANSWERS SHORT: 2-4 sentences by default, just the direct answer to what was asked. " +
        "Example of the right length: 'The rate card lists 1.18 for that conversion.' NOT a paragraph explaining the whole billing process around it. " +
        "Do not add extra background, caveats, or related information unless the person specifically asks for more detail. " +
        "The excerpts may only partially answer the question. In that case, you MAY use the web_search tool to find " +
        "the missing specific, genuinely current fact (e.g. a live exchange rate, current tariff figure) - but only for " +
        "that gap, and say plainly which part came from the docs versus a live web search. Do not search the web for " +
        "anything specific to Maurice Ward's own internal procedures - only for general, publicly-verifiable current facts. " +
        "If the excerpts don't contain the answer and web search can't help either, say so plainly rather than guessing. " +
        "Never reproduce the excerpts verbatim at length or reconstruct the document's structure section-by-section. " +
        "If the person is asking to see, get, open, or be sent the SOP/policy/billing file itself (rather than asking " +
        "a specific question about its content), do NOT paste the document content at all - just tell them the file's " +
        "name so they can find and open it in the shared folder themselves. " +
        "Use the conversation history to understand follow-up questions and pronouns." + nameNote,
      history: historyMessages,
      userContent: `Question: ${question}\n\nDocument excerpts:\n\n${contextBlock}${negativeFeedbackNote}`,
      maxTokens: 250,
      allowWebSearch: true,
      webSearchUses: 1,
    });

    return json({ answer: answer || "Sorry, something went wrong generating an answer.", sources });
  } catch (err) {
    return json({ error: String(err) }, 500);
  }
});
