// ---- Currency ----
const CURRENCY_WORDS: Record<string, string> = {
  usd: "USD", dollar: "USD", dollars: "USD", "us dollar": "USD",
  eur: "EUR", euro: "EUR", euros: "EUR",
  gbp: "GBP", pound: "GBP", pounds: "GBP", sterling: "GBP",
  jpy: "JPY", yen: "JPY",
  cny: "CNY", yuan: "CNY", rmb: "CNY",
  chf: "CHF", franc: "CHF", francs: "CHF",
  cad: "CAD", "canadian dollar": "CAD",
  aud: "AUD", "australian dollar": "AUD",
  nzd: "NZD", "new zealand dollar": "NZD",
  inr: "INR", rupee: "INR", rupees: "INR",
};

function extractCurrencies(text: string): string[] {
  const lower = text.toLowerCase();
  const positions: { code: string; index: number }[] = [];
  for (const [word, code] of Object.entries(CURRENCY_WORDS)) {
    const re = new RegExp(`\\b${word}\\b`, "i");
    const match = lower.match(re);
    if (match && match.index !== undefined) positions.push({ code, index: match.index });
  }
  positions.sort((a, b) => a.index - b.index);
  const found: string[] = [];
  for (const p of positions) if (!found.includes(p.code)) found.push(p.code);
  return found;
}

async function getExchangeRate(from: string, to: string): Promise<string | null> {
  try {
    const res = await fetch(`https://api.frankfurter.app/latest?from=${from}&to=${to}`);
    const data = await res.json();
    const rate = data?.rates?.[to];
    if (!rate) return null;
    return `1 ${from} = ${rate} ${to} today (rates via the European Central Bank, as of ${data.date}).`;
  } catch (_e) {
    return null;
  }
}

// ---- Crate/vehicle fit checker ----
function parseDimensionsCm(text: string): [number, number, number] | null {
  // Matches patterns like "120x100x150cm", "1.2m x 1m x 1.5m", "120 x 100 x 150"
  const re = /(\d+(?:\.\d+)?)\s*(cm|m|mm)?\s*x\s*(\d+(?:\.\d+)?)\s*(cm|m|mm)?\s*x\s*(\d+(?:\.\d+)?)\s*(cm|m|mm)?/i;
  const match = text.match(re);
  if (!match) return null;

  // Figure out the unit: use whichever unit is explicitly given (they should
  // all match), defaulting to cm if none specified at all
  const unit = match[2] || match[4] || match[6] || "cm";
  const toCm = (v: string) => {
    const n = parseFloat(v);
    if (unit === "m") return n * 100;
    if (unit === "mm") return n / 10;
    return n;
  };
  return [toCm(match[1]), toCm(match[3]), toCm(match[5])];
}

async function findMentionedVehicle(question: string): Promise<string | null> {
  try {
    const { data, error } = await supabase.rpc("get_all_vehicle_names");
    if (error || !data) return null;
    const lower = question.toLowerCase();
    // Prefer the longest matching name (avoids "Truck" matching before
    // "Shannon Truck" when both exist)
    const matches = data.filter((v: any) => lower.includes(v.name.toLowerCase()));
    matches.sort((a: any, b: any) => b.name.length - a.name.length);
    return matches[0]?.name || null;
  } catch (_e) {
    return null;
  }
}

function checkFit(crate: [number, number, number], vehicle: [number, number, number]): { fits: boolean; crateSorted: number[]; vehicleSorted: number[] } {
  // Sorting both descending and comparing position-by-position correctly
  // answers "does this box fit in that box in ANY axis-aligned orientation"
  const crateSorted = [...crate].sort((a, b) => b - a);
  const vehicleSorted = [...vehicle].sort((a, b) => b - a);
  const fits = crateSorted.every((d, i) => d <= vehicleSorted[i]);
  return { fits, crateSorted, vehicleSorted };
}

// ---- Ground handler rate calculator ----
function parseWeightKg(text: string): number | null {
  // Matches "400kg", "400 kg", "400kgs" - deliberately not matching things
  // like weight ranges from dimension parsing, just a standalone weight figure
  const match = text.match(/(\d+(?:\.\d+)?)\s*kgs?\b/i);
  return match ? parseFloat(match[1]) : null;
}

function parseDirection(text: string): "import" | "export" | null {
  const lower = text.toLowerCase();
  if (/\bexport/.test(lower)) return "export";
  if (/\bimport/.test(lower)) return "import";
  return null;
}

async function findMentionedHandler(question: string): Promise<string | null> {
  try {
    const { data, error } = await supabase.rpc("get_all_handler_names");
    if (error || !data) return null;
    const lower = question.toLowerCase();
    const matches = data.filter((h: any) => lower.includes(h.name.toLowerCase()));
    matches.sort((a: any, b: any) => b.name.length - a.name.length);
    return matches[0]?.name || null;
  } catch (_e) {
    return null;
  }
}

async function getHandlerRateAnswer(question: string): Promise<string | null> {
  const weight = parseWeightKg(question);
  const direction = parseDirection(question);
  if (!weight || !direction) return null;

  const handler = await findMentionedHandler(question);
  if (!handler) return null; // No known handler mentioned - let it fall through normally

  const { data: allRows, error } = await supabase.rpc("calculate_handler_charges", {
    handler_query: handler,
    direction_in: direction,
    weight_kg: weight,
  });
  if (error || !allRows || allRows.length === 0) return null;

  // Dangerous Goods charges only apply if the shipment actually contains DG -
  // including them by default would overstate the cost of an ordinary shipment
  const mentionsDG = /dangerous goods|\bdg\b|hazmat/i.test(question);
  const data = mentionsDG ? allRows : allRows.filter((r: any) => r.charge_code !== "DGCF");
  const excludedDG = allRows.length - data.length;
  if (data.length === 0) return null;

  const currency = data[0].currency;
  const lines = data.map((r: any) =>
    `- ${r.description} (${r.charge_code}): ${currency} ${r.computed_charge.toFixed(2)}${r.notes ? ` [${r.notes}]` : ""}`
  );
  const total = data.reduce((sum: number, r: any) => sum + Number(r.computed_charge), 0);
  const mixedCurrency = data.some((r: any) => r.currency !== currency);
  const currencyNote = mixedCurrency
    ? "\n\nNote: these lines are in different currencies - do not sum directly."
    : "";
  const effectiveDates = [...new Set(data.map((r: any) => r.effective_date).filter(Boolean))];
  const dateNote = effectiveDates.length ? ` (rates effective ${effectiveDates.join(", ")})` : "";
  const dgNote = excludedDG > 0
    ? "\n\n(A Dangerous Goods check charge applies to this handler/direction but isn't included above since this doesn't look like a DG shipment - mention 'dangerous goods' if it is, to include it.)"
    : "";

  return `${handler} ${direction} charges for ${weight}kg${dateNote}:\n\n${lines.join("\n")}${currencyNote}\n\nEstimated total: ${currency} ${total.toFixed(2)}${dgNote}\n\n(This covers standard handling/facility/security/DG categories only - not every special-service line item. Double-check against the source rate card for anything unusual, like temperature-controlled cargo, valuables, or out-of-hours charges.)`;
}

async function getCrateFitAnswer(question: string): Promise<string | null> {
  const crateDims = parseDimensionsCm(question);
  if (!crateDims) return null;

  const vehicleName = await findMentionedVehicle(question);
  if (!vehicleName) return null; // No known vehicle mentioned - let it fall through normally

  const { data, error } = await supabase.rpc("get_vehicle_by_name", { name_query: vehicleName });
  if (error || !data || data.length === 0) return null;
  const v = data[0];
  const vehicleDims: [number, number, number] = [v.internal_length_cm, v.internal_width_cm, v.internal_height_cm];

  const { fits, crateSorted, vehicleSorted } = checkFit(crateDims, vehicleDims);
  const crateStr = crateDims.map((d) => `${d}cm`).join(" x ");
  const vehicleStr = `${v.internal_length_cm} x ${v.internal_width_cm} x ${v.internal_height_cm} cm`;

  if (fits) {
    const clearances = crateSorted.map((d, i) => (vehicleSorted[i] - d).toFixed(0));
    return `Yes, a ${crateStr} crate fits in the ${v.name} (internal ${vehicleStr}). Clearance: ${clearances.join("cm, ")}cm on the three axes once oriented to fit.`;
  } else {
    const oversizedBy = (crateSorted[0] - vehicleSorted[0]).toFixed(0);
    return `No, a ${crateStr} crate won't fit in the ${v.name} (internal ${vehicleStr}) in any orientation - it's about ${oversizedBy}cm too big on its largest dimension relative to the truck's largest internal dimension.`;
  }
}

